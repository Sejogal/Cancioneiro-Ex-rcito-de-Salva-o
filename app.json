{
  "expo": {
    "name": "Cancioneiro Exército de Salvação - Beta",
    "slug": "CES1_0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-ces.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "permissions": ["INTERNET"],
      "package": "com.sethlussueki.CES1_0",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-ces.png",
        "backgroundColor": "#E6F4FE",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-ces.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-ces.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "eas": {
        "projectId": "0fd19992-6bc8-4131-828b-3c8c2e88b765"
      }
    }
  },

  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-8330853390940980~9847911330"
  }
}
