{
  "expo": {
    "name": "Cancioneiro Exército de Salvação - Beta",
    "slug": "CES1_0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-ces.png", //atualmente o icon principal - splash icon está ser renderizado aqui ao testar no expo go, mas ao exportar o app ele não renderiza.
    "scheme": "ces10",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon-ces.png", // Icone do app está ser renderizado aqui corretamente ao exportar o app.
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sethlussueki.CES1_0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-ces.png" //alterando.... favicon.png
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-ces.png", // colocando a imagem do splash icon aqui após exportar o app, a imagem não aparece. 
          "imageBorder": 4,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0fd19992-6bc8-4131-828b-3c8c2e88b765"
      }
    }
  }
}
